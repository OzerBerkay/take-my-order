# Dev ortamı için oluşturulmuştur. Prod ortamı için central-hub içerisinde doğru değerlerle yeniden oluşturulmalıdır

# Veritabanı Username ve Şifresi
DB_PASSWORD=admin
DB_USERNAME=postgres

# Keycloak Username ve Şifresi
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=dev-secret-placeholder
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=admin

# Master Node IP Adresleri
MASTER_PUBLIC_IP=host.docker.internal
MASTER_PRIVATE_IP=host.docker.internal