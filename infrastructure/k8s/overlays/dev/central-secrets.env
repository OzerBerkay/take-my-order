# Dev ortamı için oluşturulmuştur. Prod ortamı için central-hub içerisinde doğru değerlerle yeniden oluşturulmalıdır

# Veritabanı Username ve Şifresi
DB_PASSWORD=admin
DB_USERNAME=postgres

# Keycloak Username ve Şifresi
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=dev-secret-placeholder
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://localhost:30080
KC_PROXY=none

# Master Node / Veritabanı Adresi
MASTER_PUBLIC_IP=localhost
# Varsayılan (Mod B): Küme içi dev-only PostgreSQL 16 poduna (overlays/dev/postgres.yaml) bağlanır.
# İsteğe bağlı olarak Mod B'de host makinedeki bare-metal PostgreSQL'i kullanmak isterseniz
# aşağıdaki satırı 'host.docker.internal' yapıp kustomization.yaml içindeki 'postgres.yaml' satırını yorum satırına alın.
MASTER_PRIVATE_IP=postgres

# Gateway CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# System Super Admin (Local Dev)
SYSTEM_ADMIN_EMAIL=admin@takemyorder.com
SYSTEM_ADMIN_PASSWORD=Admin123!